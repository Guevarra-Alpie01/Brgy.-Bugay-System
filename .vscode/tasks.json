{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Run Bugay System Django server",
            "type": "shell",
            "command": "${workspaceFolder}\\run_django.bat",
            "isBackground": true,
            "problemMatcher": {
                "owner": "django",
                "pattern": {
                    "regexp": "^$"
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": ".*Watching for file changes with.*",
                    "endsPattern": ".*Starting development server at.*"
                }
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "dedicated"
            },
            "runOptions": {
                "runOn": "folderOpen",
                "instanceLimit": 1
            }
        }
    ]
}
